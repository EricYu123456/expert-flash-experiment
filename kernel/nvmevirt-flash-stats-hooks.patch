diff --git a/ssd.c b/ssd.c
index bc91f58..9846e00 100644
--- a/ssd.c
+++ b/ssd.c
@@ -2,10 +2,75 @@
 
 #include <linux/ktime.h>
 #include <linux/sched/clock.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/mutex.h>
 
 #include "nvmev.h"
 #include "ssd.h"
 
+/* This reports the genuine conventional-SSD NAND path, separate from AiF. */
+static DEFINE_MUTEX(flash_stats_lock);
+static struct ssd *flash_stats_ssds[SSD_PARTITIONS];
+static struct proc_dir_entry *flash_stats_proc;
+
+static int flash_stats_show(struct seq_file *m, void *unused)
+{
+    int p, c, l;
+    mutex_lock(&flash_stats_lock);
+    seq_puts(m, "partition,channel,lun,read_commands,read_bytes,nand_read_ns\n");
+    for (p = 0; p < SSD_PARTITIONS; p++) {
+        struct ssd *ssd = flash_stats_ssds[p];
+        if (!ssd)
+            continue;
+        for (c = 0; c < ssd->sp.nchs; c++) {
+            for (l = 0; l < ssd->sp.luns_per_ch; l++) {
+                struct nand_lun *lun = &ssd->ch[c].lun[l];
+                seq_printf(m, "%d,%d,%d,%llu,%llu,%llu\n", p,
+                           p * ssd->sp.nchs + c, l,
+                           READ_ONCE(lun->stats_read_commands),
+                           READ_ONCE(lun->stats_read_bytes),
+                           READ_ONCE(lun->stats_nand_read_ns));
+            }
+        }
+    }
+    mutex_unlock(&flash_stats_lock);
+    return 0;
+}
+
+static void flash_stats_register(struct ssd *ssd)
+{
+    int p;
+    mutex_lock(&flash_stats_lock);
+    for (p = 0; p < SSD_PARTITIONS; p++) {
+        if (!flash_stats_ssds[p]) {
+            flash_stats_ssds[p] = ssd;
+            break;
+        }
+    }
+    if (!flash_stats_proc)
+        flash_stats_proc = proc_create_single("nvmevirt_flash_stats", 0444, NULL,
+                                             flash_stats_show);
+    mutex_unlock(&flash_stats_lock);
+}
+
+static void flash_stats_unregister(struct ssd *ssd)
+{
+    int p;
+    bool any = false;
+    mutex_lock(&flash_stats_lock);
+    for (p = 0; p < SSD_PARTITIONS; p++) {
+        if (flash_stats_ssds[p] == ssd)
+            flash_stats_ssds[p] = NULL;
+        any |= flash_stats_ssds[p] != NULL;
+    }
+    mutex_unlock(&flash_stats_lock);
+    if (!any) {
+        proc_remove(flash_stats_proc);
+        flash_stats_proc = NULL;
+    }
+}
+
 static inline uint64_t __get_ioclock(struct ssd *ssd)
 {
 	return cpu_clock(ssd->cpu_nr_dispatcher);
