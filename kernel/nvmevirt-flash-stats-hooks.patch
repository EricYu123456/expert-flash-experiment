 void ssd_remove(struct ssd *ssd)
 {
 	uint32_t i;
+    flash_stats_unregister(ssd);
 
 	kfree(ssd->write_buffer);
 	if (ssd->pcie) {
@@ -396,6 +466,9 @@ uint64_t ssd_advance_nand(struct ssd *ssd, struct nand_cmd *ncmd)
 		} else {
 			nand_etime = nand_stime + spp->pg_rd_lat[cell];
 		}
+        lun->stats_read_commands++;
+        lun->stats_read_bytes += ncmd->xfer_size;
+        lun->stats_nand_read_ns += nand_etime - nand_stime;
 
 		/* read: then data transfer through channel */
 		chnl_stime = nand_etime;
