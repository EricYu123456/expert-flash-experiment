{
  "status": "review_complete",
  "reviewed_source_path": "/home/ericyu/expert_flash_experiment/scripts/research_20261109_cost_audit.py",
  "reviewed_source_sha256": "d55752507b9c76779127c5da17ec7c0c6636c87cc47b905157d672aa3a61fb60",
  "review_source_sha256": "f76893918f4bf4e275d36392faf29303c4004e1e8d0dbc6921079bf96da99939",
  "findings": [
    {
      "priority": 1,
      "lines": [
        44,
        56,
        59
      ],
      "finding": "Ranking and denominator are restricted to 3 layers. Final single-layer cohorts require all26-layer native cache competitors and all26 routed denominator; shared FFN/attention/LMhead remain excluded from that arithmetic denominator."
    },
    {
      "priority": 1,
      "lines": [
        62,
        64
      ],
      "finding": "With all private C resident and identical eligible experts/native GU pool, raw-x and nonlinear readout have exactly the same modeled flash coefficient work. Representation advantage must come from quality/coverage/host cost, not assigning raw C to flash."
    },
    {
      "priority": 1,
      "lines": [
        66,
        72
      ],
      "finding": "Hard-coded fullraw2048 is not the actual same-width rawsubset1408 control. Read actual registry payload and transform sizes, and optionally fill remaining equal budget using the frozen native-cache ranking."
    },
    {
      "priority": 1,
      "lines": [
        29,
        62
      ],
      "finding": "Assert prototype owners are disjoint from substituted heads. Native-owner overlap can offset extra GU only for identical native weights and an unchanged native owner path; a learned GU with the same owner ID is a distinct basis/cache."
    },
    {
      "priority": 2,
      "lines": [
        41,
        89
      ],
      "finding": "Incremental C+GU budget is not a complete host memory budget. Specify common native shared FFN, nonFFN tensors, KV/workspace, page/allocator overhead and whether original fallback stays flash or host; full native residency is a legitimate upper-budget control."
    },
    {
      "priority": 2,
      "lines": [
        62,
        87
      ],
      "finding": "Resident C has no flash coefficient reads, but still has host weight/activation traffic, H*r readout MACs, transform/A8 contexts and potentially serial GU\u2192SwiGLU\u2192A8\u2192C latency. Do not infer speedup from coefficient access work."
    },
    {
      "priority": 2,
      "lines": [
        56,
        83
      ],
      "finding": "Separate deterministic BOS from nonBOS; freeze rankings before TEST. NLL63/all64/decode exposures need separate causal scopes, and VALID-selected cache hit estimates on VALID are optimistic."
    },
    {
      "priority": 2,
      "lines": [
        49,
        50
      ],
      "finding": "Pure GU/full-expert equal-unit prefixes are valid strong policies, not a global optimum over arbitrary mixed GU/D/full-expert caching and page granularity."
    }
  ],
